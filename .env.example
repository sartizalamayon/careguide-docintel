# Copy to .env and fill in. Never commit .env.

# Shared secret between the web proxy and the API (>= 16 chars). Generate: openssl rand -hex 24
API_KEY=change-me-to-a-long-random-string

# LLM: any OpenAI-compatible endpoint. Default = Google Gemini (key from https://aistudio.google.com/apikey)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_JSON_MODE=schema
LLM_CONCURRENCY=4
LLM_CACHE_ENABLED=true
# Used after 3 failed tries on LLM_MODEL (overload, rate limit, timeout). Empty URL/key = same provider as above.
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
# Groq (key from https://console.groq.com/keys) as the fallback:
#   LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1  LLM_FALLBACK_MODEL=openai/gpt-oss-120b  LLM_FALLBACK_API_KEY=gsk_...
# or as the main provider:  LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=openai/gpt-oss-120b

# Google sign-in, so users can add their own Groq key in the UI (optional).
# Create an OAuth client (type "Web application") at https://console.cloud.google.com/apis/credentials
# with the redirect URI  http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the session cookie. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Encrypts the stored user keys. Empty = derived from API_KEY (changing API_KEY then makes saved keys unreadable).
CREDENTIALS_SECRET=

# Processing
OCR_THREADS=4
OCR_DPI=300
MAX_FILE_MB=200
MAX_FILES_PER_UPLOAD=50
REVIEW_CONFIDENCE=0.6

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
