erDiagram
  documents ||--o{ document_pages : has
  documents ||--o{ invoices : contains
  documents ||--o{ processing_events : logs
  invoices ||--o{ line_items : has
  invoices ||--o{ validation_issues : flagged_by
  invoices ||--o{ corrections : audited_by
  documents ||--o{ cross_checks : "compared (a/b)"
  documents {
    uuid id PK
    uuid batch_id
    text filename
    text file_type
    text family
    char sha256
    text status
    text stage
    smallint progress
    int pages_total
    text error_code
    int attempts
    int processing_ms
  }
  document_pages {
    bigint id PK
    uuid document_id FK
    int page_no
    text method
    text text
    real ocr_confidence
  }
  invoices {
    uuid id PK
    uuid document_id FK
    int seq
    text invoice_number
    date invoice_date
    text supplier_name
    text customer_name
    char currency
    numeric subtotal
    numeric tax
    numeric total
    jsonb field_meta
    text status
    tsvector search_tsv
    vector embedding
  }
  line_items {
    bigint id PK
    uuid invoice_id FK
    int position
    text description
    numeric quantity
    numeric unit_price
    numeric amount
  }
  validation_issues {
    bigint id PK
    uuid invoice_id FK
    text code
    text severity
    text field
    text message
  }
  corrections {
    bigint id PK
    uuid invoice_id FK
    text field
    jsonb old_value
    jsonb new_value
    text corrected_by
  }
  processing_events {
    bigint id PK
    uuid document_id FK
    text event
    text stage
    jsonb data
  }
  cross_checks {
    uuid id PK
    uuid document_a_id FK
    uuid document_b_id FK
    jsonb summary
  }
  llm_calls {
    bigint id PK
    char cache_key UK
    text model
    int input_tokens
    int output_tokens
    jsonb response
  }
